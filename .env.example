# Copy to .env and fill in. Vite only exposes variables that start with VITE_ to the browser,
# so never put secret keys here: these values end up in the public site.

# Hosted checkout page. When set, "Checkout" in the bag sends the shopper there with ?items=id:qty,id:qty
VITE_CHECKOUT_URL=https://checkout.example.com/tranzlife

# Endpoint that accepts the contact form as JSON (name, email, topic, msg), e.g. a form service or CRM webhook.
VITE_CONTACT_ENDPOINT=https://forms.example.com/tranzlife-contact
